   <widget class="QPushButton" name="unos">
    <property name="geometry">
     <rect>
      <x>120</x>
      <y>300</y>
      <width>271</width>
      <height>101</height>
     </rect>
    </property>
    <property name="styleSheet">
     <string notr="true">QPushButton {
    /* Početni izgled kada se program lansira */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2a0a0a, stop:1 #4a1212);
    color: #ffffff;
    border: 1px solid #5a1a1a;
    border-radius: 8px;
    padding: 8px 16px;
    font-family: 'Segoe UI', 'Century Gothic', Calibri;
    font-size: 11pt;
    font-weight: bold;
    
    /* KLJUČ ZA ANIMACIJU: Glatki prelaz za sve promjene (boja, ivica, sjenka) u trajanju od 300ms */
    qproperty-minimumSize: 80px 35px;
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
}

/* KADA SE MIŠ DOVUČE IZNAD DUGMETA (HOVER EFFECT) */
QPushButton:hover {
    /* Glatko posvijetli u jarku crvenu i dobije neonski sjaj */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #5a1515, stop:1 #9e2a2a);
    border: 1px solid #ff4d4d;
    color: #ffffff;
    
    /* Efekat blagog unutrašnjeg sjaja */
    padding-bottom: 9px; 
}

/* KADA KORISNIK KLIKNE DUGME (PRESSED EFFECT) */
QPushButton:pressed {
    /* Duboka, tamna crvena boja koja daje privid da je dugme fizički utonulo */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1a0505, stop:1 #330a0a);
    border: 1px solid #b33a3a;
    color: #b3b3b3;
    
    /* Pomjeranje teksta za 1 piksel dole i desno stvara savršen 3D osjećaj klika */
    padding-top: 10px;
    padding-left: 17px;
}

/* U slučaju da je neko dugme isključeno (disabled) */
QPushButton:disabled {
    background-color: #1a1a1a;
    color: #555555;
    border: 1px solid #2a2a2a;
}</string>
    </property>
    <property name="text">
